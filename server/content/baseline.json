      "id": "baseline-1",
      "category": "theory",
      "prompt": "Baseline test là gì?",
      "choices": [
        {
          "id": "A",
          "text": "Bài kiểm thử thiết lập bộ số liệu nền ở điều kiện tải xác định, làm mốc so sánh cho các lần chạy sau."
        },
        {
          "id": "B",
          "text": "Bài kiểm thử chỉ xác nhận một luồng API có chạy được hay không."
        },
        {
          "id": "C",
          "text": "Bài kiểm thử tạo tải tăng đột ngột để quan sát phản ứng tức thời."
        },
        {
          "id": "D",
          "text": "Bài kiểm thử luôn phải đẩy hệ thống đến khi ngừng phục vụ."
        }
      ],
      "correct": "A",
      "explanation": "Baseline là mốc so sánh có ghi rõ workload, dữ liệu và môi trường. Trong bài này, nhóm quan sát tải bình thường ở mức 50 VUs."
    },
    {
      "id": "baseline-2",
      "category": "theory",
      "prompt": "Vì sao nên quan sát cửa sổ tải ổn định (steady) khi thiết lập số liệu nền?",
      "choices": [
        {
          "id": "A",
